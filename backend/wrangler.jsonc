{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arkeocaja-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "d1_databases": [
    { "binding": "DB", "database_name": "arkeocaja", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ]
}
